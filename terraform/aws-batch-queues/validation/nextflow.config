// Spend-bearing integration fixture. Run only with explicit authorization.
process.executor = 'awsbatch'
// Fixture only: force a visible Nextflow retry, without waiting for reclamation.
process.maxRetries = 1
process.errorStrategy = 'retry'
aws.batch.maxSpotAttempts = 0
trace {
    enabled = true
    fields = 'task_id,hash,native_id,name,status,exit,attempt,queue,cpus,memory'
}
