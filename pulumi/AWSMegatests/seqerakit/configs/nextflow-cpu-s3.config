// Nextflow configuration for CPU S3 (no Fusion) compute environments
// Includes base configuration and S3-specific settings
// Falls back to on-demand queue on spot reclamation retries

includeConfig 'nextflow-base.config'

process {
    queue = { task.attempt < 2 ?: 'TowerForge-2EpsyHp9v0qmee4Dotd37b' }
}
